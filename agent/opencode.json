{
  "$schema": "https://opencode.ai/config.json",
  "model": "greenpt/deepseek-v4-flash-0731",
  "instructions": [
    "OPERATING.md"
  ],
  "provider": {
    "greenpt": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GreenPT",
      "options": {
        "baseURL": "https://api.greenpt.ai/v1",
        "apiKey": "{env:GREENPT_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 128000,
            "output": 32768
          }
        },
        "devstral-2-123b-instruct-2512": {
          "name": "Devstral 2 123B"
        },
        "gemma4": {
          "name": "Gemma 4"
        },
        "glm-5.2": {
          "name": "GLM-5.2",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "minimax-m2.5": {
          "name": "MiniMax M2.5",
          "limit": {
            "context": 200000,
            "output": 131072
          }
        }
      }
    }
  },
  "tools": {
    "*": false,
    "author-posts": true,
    "create-draft": true,
    "followers": true,
    "follows": true,
    "liked-by": true,
    "liked-posts": true,
    "profile": true,
    "reposted-by": true,
    "search-actors": true,
    "search-posts": true,
    "show-actor": true,
    "show-post": true,
    "thread-posts": true
  },
  "agent": {
    "build": {
      "description": "The reader. Bluesky tools only \u2014 what every user gets.",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "read": {
          "*": "deny"
        }
      }
    },
    "focused": {
      "description": "The reader with four tools instead of thirteen, for models that lose the thread when given too many.",
      "mode": "primary",
      "tools": {
        "*": false,
        "search-posts": true,
        "show-post": true,
        "thread-posts": true,
        "profile": true
      },
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "read": {
          "*": "deny"
        }
      }
    },
    "builder": {
      "description": "Reads, writes and runs things on this machine. Not for users.",
      "mode": "primary",
      "tools": {
        "author-posts": true,
        "create-draft": true,
        "followers": true,
        "follows": true,
        "liked-by": true,
        "liked-posts": true,
        "profile": true,
        "reposted-by": true,
        "search-actors": true,
        "search-posts": true,
        "show-actor": true,
        "show-post": true,
        "thread-posts": true,
        "bash": true,
        "write": true,
        "edit": true,
        "read": true,
        "grep": true,
        "glob": true,
        "list": true
      },
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": {
          "*": "allow"
        }
      }
    }
  }
}
