# The provider key and the ntfy token — never commit. (It held a Bluesky app
# password once; it does not any more, and nothing here does.)
#
# The glob covers the backups people make before editing it. `.env.bak-<date>`
# is the same secrets under a name the old single-line rule did not match, and
# it only takes one `git add -A` in a public repo. The exception keeps the one
# file in this family that is meant to be read by everybody.
.env
.env.*
!.env.example

# Private projects — the public agent is denied read access here, and these
# stay untracked so private work never lands in the repo.
private/

# Runtime state written by the post tools (index -> at:// URI mapping)
tools/.post_index.jsonl

# CAUSE prototype run log (local data, not atproto)
cause/causes.json

# The evolving keyword index — the pool and the verified posts are runtime data
index/keywords.json
index/posts.json
index/stats.json

# The feed builder's runtime state — one file, one record per feed
feeds/feeds.json

# Shared case file the agent + background workers append findings to
NOTES.md

# Cached Bluesky session tokens — never commit. The glob matters: a second
# account (publishing) caches to .session-publish.json, and an app password
# grants full write access to whatever it belongs to.
tools/.session*.json

# Python bytecode
__pycache__/
*.pyc

# The OAuth sidecar's dependencies — installed with npm, never committed
oauth/node_modules/
